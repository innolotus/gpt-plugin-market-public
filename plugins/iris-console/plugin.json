{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "iris-console",
  "version": "0.1.2",
  "description": "Evidence-aware Australian property research, investment and development workflows.",
  "author": {
    "name": "LabLotus",
    "url": "https://github.com/lablotus/Iris-B-RE"
  },
  "homepage": "https://github.com/lablotus/Iris-B-RE",
  "repository": "https://github.com/lablotus/Iris-B-RE",
  "keywords": ["australia", "property", "investment", "development", "real-estate"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Iris Console",
        "shortDescription": "Australian property analysis",
        "longDescription": "Research Australian suburbs and properties, preserve evidence quality, compare acquisition, investment and development strategies, and produce auditable Iris reports.",
        "developerName": "LabLotus",
        "category": "Productivity",
        "capabilities": ["Interactive"],
        "websiteURL": "https://github.com/lablotus/Iris-B-RE",
        "brandColor": "#E65300",
        "composerIcon": "./Assets/Brand/iris-logo-mark-report.png",
        "logo": "./Assets/Brand/iris-logo-mark-report.png",
        "defaultPrompt": [
          "Start Iris and help me choose the right analysis.",
          "Analyse the suburb Lightsview, SA 5085.",
          "Assess an Australian property address for me."
        ]
      }
    }
  }
}
